# Core Pipeline Parameters
SPHERICAL_MESH_LEVEL="3"          # Subdivisions for icosahedral mesh
ENSEMBLE_MEMBERS="21"             # NEPS-G standard ensemble size
DIFFUSION_STEPS="20"              # Denoising steps for 12km -> 5km downscaling
PHYSICS_LOSS_WEIGHT="0.25"        # Weight of thermodynamic and fluid penalties
ENABLE_MONGO_LOCAL_FALLBACK="True" # Auto-fallback to local in-memory/JSON store if MongoDB daemon is offline
